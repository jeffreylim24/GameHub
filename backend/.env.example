# Database Configuration
# PostgreSQL connection settings
# Adjust these values according to your local setup
DB_HOST=localhost
DB_USER=gamehub_user
DB_PASSWORD=your_password_here
DB_NAME=gamehub
DB_PORT=5432
DB_SSLMODE=disable
DB_TZ=Asia/Singapore

# Server Configuration
# Port for the backend server to listen on
PORT=8080

# JWT Configuration
# Secret key for signing JWT tokens - MUST be set to a strong random value
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# JWT token expiry in hours (default: 24 hours)
JWT_EXPIRY_HOURS=24

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:5173,http://localhost:3000
# Put your frontend URL(s) here
CORS_ALLOWED_ORIGINS=http://localhost:5173